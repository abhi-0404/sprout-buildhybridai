rules_version = '2';
// Sprout stores no child identity or transcripts in Firestore: only family membership,
// safety alerts (kind, level, time) and join requests. Only family members can read them.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function family(familyId) { return get(/databases/$(database)/documents/families/$(familyId)).data; }
    function isMember(familyId) { return signedIn() && request.auth.uid in family(familyId).members; }
    function isOwner(familyId) { return signedIn() && request.auth.uid == family(familyId).ownerUid; }

    match /families/{familyId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'ownerUid', 'code', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      allow read: if isMember(familyId);
      // Only the owner changes membership; the owner can never change or be removed.
      allow update: if isOwner(familyId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.auth.uid in request.resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']);

      // A joiner files only their own small request; the owner reads and resolves it.
      match /joinRequests/{uid} {
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'at'])
          && request.resource.data.uid == uid
          && request.resource.data.name is string && request.resource.data.name.size() <= 60
          && request.resource.data.at is int;
        allow get: if signedIn() && request.auth.uid == uid;
        allow read, delete: if isOwner(familyId);
      }

      // Alerts carry no text: only kind, level and time. Append-only.
      match /alerts/{alertId} {
        allow read: if isMember(familyId);
        allow create: if isMember(familyId)
          && request.resource.data.keys().hasOnly(['kind', 'level', 'at'])
          && request.resource.data.kind in ['self_harm', 'abuse', 'online_danger', 'bullying', 'sad_or_scared']
          && request.resource.data.level in ['concern', 'urgent']
          && request.resource.data.at is int;
        allow update, delete: if false;
      }
    }

    // 6-digit join codes point at a family; exact lookup only (no listing).
    // Known limitation: codes are guessable at scale; approval by the owner is required to join,
    // and App Check enforcement limits scripted lookups. Production: random expiring codes via a Function.
    match /joinCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['familyId', 'ownerUid'])
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
