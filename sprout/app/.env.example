# Copy to .env.local and fill from Firebase console > Project settings > Your apps > Web app.
# These are public web config values, but keep .env.local out of git anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# App Check (required by Firebase AI Logic): reCAPTCHA Enterprise site key.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Optional: fixed App Check debug token for local dev (never commit a real one).
VITE_APPCHECK_DEBUG_TOKEN=
VITE_CLOUD_MODEL=gemini-3.5-flash
# Optional: cloud thinking level (MINIMAL, LOW, MEDIUM, HIGH). Default MINIMAL; gemini-3.8-flash needs LOW or higher.
# VITE_CLOUD_THINKING=MINIMAL
