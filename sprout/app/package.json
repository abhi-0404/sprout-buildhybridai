{
  "name": "sprout-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "eval": "vitest run --config vitest.eval.config.ts",
    "e2e": "pnpm build && node --experimental-websocket e2e/run.mjs",
    "firebase": "pnpm dlx firebase-tools@15.37.0 --config ../firebase/firebase.json",
    "hosting": "pnpm build && pnpm firebase deploy --only hosting"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "^8.6.2",
    "firebase": "^13.3.0",
    "lucide-react": "0.525.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "axe-core": "^4.14.0",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
